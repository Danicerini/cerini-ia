# Cerini IA — configurazione d'esempio. Copiala in /opt/ollama-web/.env e metti i tuoi valori.
# Qui ci sono solo valori finti: le chiavi vere non vanno MAI nel repository.

# --- Base -------------------------------------------------------------------
# Dove gira Ollama (il PC con la GPU). Se cambia IP, il pannello lo cerca in DISCOVER_SUBNET.
OLLAMA_URL=http://192.168.1.50:11434
DISCOVER_SUBNET=192.168.1.0/24
KEEP_ALIVE=15m
NUM_CTX=32768
# Indirizzo pubblico del pannello (serve per i link nelle mail, Google e le notifiche)
PUBLIC_URL=https://assistente.example.com
# Il proxy davanti al pannello (cloudflared, nginx…): solo da questi IP si crede a X-Forwarded-For
TRUSTED_PROXIES=
# Chiave per firmare le sessioni: la genera install-ct.sh
SECRET_KEY=cambiami-con-64-caratteri-casuali
SESSION_HOURS=168
# Primo amministratore (la password la imposta set-password.sh)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# --- Chi gestisce l'app (pagina /privacy) -----------------------------------
OWNER_NAME=Mario Rossi
OWNER_EMAIL=mario.rossi@example.com

# --- Accensione del PC -------------------------------------------------------
# Wake-on-LAN e/o un ESP32 che preme il tasto di accensione
WOL_MAC=
WOL_BROADCAST=192.168.1.255
PC_HOST=
ESP32_URL=

# --- Posta in uscita (inviti, password dimenticata): set-smtp.sh --------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cerini IA <noreply@example.com>

# --- Gmail e Google Calendar dell'utente: set-google.sh -----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Dettatura (Whisper sul PC, vedi pc/whisper) ------------------------------
WHISPER_PORT=8765
WHISPER_TOKEN=

# --- Homebase (dashboard di casa, facoltativa: vedi homebase/) ----------------
HOMEBASE_URL=
HOMEBASE_HOST=
HOMEBASE_PUBLIC=
HOMEBASE_KEY=

# --- Sito di un locale (facoltativo: menu, eventi) ----------------------------
SITE_NAME=Pizzeria da Mario
SITE_DOMAIN=pizzeriadamario.example
SITE_API_URL=
SITE_API_KEY=

# --- Ricerca web (facoltativa: un SearXNG tuo) --------------------------------
SEARXNG_URL=
