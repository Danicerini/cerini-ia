#!/usr/bin/env python3
"""I siti dei clienti sul server dei siti: una cartella per persona, un sito per sottocartella.
Ognuno lavora da solo sui siti che ha preso in carico (agli altri dà una mano solo se il suo umano glielo chiede);
i Claude non si danno compiti tra loro. Aura legge commit, file in modifica e il diario di Claude e risponde alle persone.

Struttura (la guida per chi ci lavora è /srv/siti/LEGGIMI.md):
  /srv/siti/<persona>/<slug>/            la cartella di lavoro di ognuno su quel sito (worktree git, branch <utente>/…)
  /srv/siti/.progetti/<slug>/main/       il sito "vero" (branch main). Non si tocca a mano: ci si arriva con «sito consegna».
  /srv/siti/.progetti/<slug>/diario.jsonl  il diario di Claude: cosa sta facendo e cosa ha fatto (lo legge Aura)
  /srv/siti/.progetti/<slug>/sito.json   nome, cliente, chi l'ha preso in carico, porte, repository GitHub

Comandi per le persone (e i loro Claude):
  sito elenco                                   i progetti
  sito stato <slug>                             cosa succede nel progetto (JSON con --json)
  sito apri <slug> [utente]                     regole del sito e novità su main (prima di lavorarci)
  sito diario <slug> <testo…>                   una riga nel diario: cosa stai facendo o cosa hai fatto (la legge Aura)
  sito avvio-tutti <utente>                     la guida, i tuoi siti e gli altri (all'apertura di Claude sul PC)
  sito novita-tutti <utente>                    solo le novità su main da prendere (zitto se niente)
  sito consegna                                 dalla tua cartella: rebase su main e main avanza (GitHub si aggiorna da solo)
Comandi di servizio (root o aura):
  sito nuovo <slug> <nome> <chi> [note…]        crea il progetto e le cartelle di tutti
  sito github                                   crea i repository mancanti e manda main e i branch su GitHub
  sito attivita <da-timestamp>                  cosa è successo in tutti i progetti da quel momento (JSON, per Aura)
"""
import fcntl, json, os, pwd, re, shutil, subprocess, sys, time, urllib.request, urllib.error
from datetime import datetime
from pathlib import Path

os.environ.setdefault("TZ", "Europe/Rome")   # orari come li leggono le persone (il server sta in UTC)
time.tzset()
ROOT = Path("/srv/siti")
COMUNE = ROOT / ".progetti"                    # la parte in comune di ogni sito: main, diario, dati
CONF = Path("/etc/siti/config.json")          # utenti, account GitHub, collaboratori
TOKEN = Path("/etc/siti/github.token")        # solo l'utente aura la legge
SLUG = re.compile(r"^[a-z0-9][a-z0-9-]{1,40}$")


def conf() -> dict:
    try:
        return json.loads(CONF.read_text())
    except (OSError, ValueError):
        return {}


def users() -> list[str]:
    return conf().get("utenti") or []


def cartella(u: str) -> Path:
    """La cartella di una persona in /srv/siti (il nome lo sceglie lei: «cartelle» nella configurazione)."""
    return ROOT / ((conf().get("cartelle") or {}).get(u) or u)


def wt(p: Path, u: str) -> Path:
    """La cartella di lavoro di una persona su un sito."""
    return cartella(u) / p.name


def progetti() -> list[Path]:
    return sorted(x for x in COMUNE.iterdir() if (x / "sito.json").exists()) if COMUNE.exists() else []


def die(msg: str, code: int = 1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def git(*a, cwd=None, check=True) -> str:
    r = subprocess.run(["git", *a], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode:
        die(f"git {' '.join(a)}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def proj(slug: str) -> Path:
    if not SLUG.match(slug or ""):
        die("nome di progetto non valido (minuscole, numeri e trattini)")
    p = COMUNE / slug
    if not (p / "main" / ".git").exists():
        die(f"progetto «{slug}» non trovato")
    return p


def meta(p: Path) -> dict:
    try:
        return json.loads((p / "sito.json").read_text())
    except (OSError, ValueError):
        return {"slug": p.name, "nome": p.name}


def now() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M")


# ------------------------------------------------------------------ diario di Claude (lo legge Aura)
def leggi_diario(p: Path, n: int = 0) -> list[dict]:
    try:
        rows = [json.loads(l) for l in (p / "diario.jsonl").read_text().splitlines() if l.strip()]
    except (OSError, ValueError):
        return []
    return rows[-n:] if n else rows


def diario(slug: str, testo: str):
    p = proj(slug)
    testo = " ".join(testo.split())[:1000]
    if not testo:
        die("uso: sito diario <slug> <testo…>")
    with open(p / ".diario.lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        rows = leggi_diario(p)[-299:] + [{"ts": int(time.time()), "at": now(), "chi": me(), "testo": testo}]
        tmp = p / f".diario.{os.getpid()}.tmp"
        tmp.write_text("".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows))
        os.chmod(tmp, 0o664)
        tmp.replace(p / "diario.jsonl")
    print("Scritto nel diario.")


# ------------------------------------------------------------------ stato
def main_log(p: Path, n: int = 10, ref: str = "main", since: str = "") -> list[dict]:
    args = ["log", ref, f"-{n}", "--format=%h%x09%an%x09%at%x09%s"]
    if since:
        args.insert(2, f"{since}")
    out = git(*args, cwd=p / "main", check=False)
    return [dict(zip(("hash", "chi", "ts", "testo"), (l.split("\t", 3) + [""] * 4)[:4])) for l in out.splitlines() if l]


def stato(slug: str) -> dict:
    p = proj(slug)
    m = meta(p)
    gente = []
    for u in users():
        w = wt(p, u)
        if not w.exists():
            continue
        branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=w, check=False)
        dirty = [l[3:] for l in git("status", "--porcelain", cwd=w, check=False).splitlines()]
        ahead = git("rev-list", "--count", f"main..{branch}", cwd=w, check=False) or "0"
        behind = git("rev-list", "--count", f"{branch}..main", cwd=w, check=False) or "0"
        last = 0
        for f in dirty[:50]:
            try:
                last = max(last, int((w / f).stat().st_mtime))
            except OSError:
                pass
        commits = main_log(p, 5, f"main..{branch}") if branch and branch != "HEAD" else []
        gente.append({"utente": u, "cartella": str(w), "branch": branch, "da_consegnare": int(ahead), "indietro": int(behind), "modifiche": len(dirty),
                      "file_modificati": dirty[:12], "ultima_modifica": last, "commit": commits})
    return {**m, "main": main_log(p, 10), "persone": gente, "diario": leggi_diario(p, 20)}


def stampa_stato(s: dict):
    print(f"# {s.get('nome')} ({s.get('slug')})" + (f" — preso in carico da {s['chi']}" if s.get("chi") else ""))
    if s.get("github"):
        print(f"GitHub: {s['github']}")
    for g in s["persone"]:
        print(f"- {g['utente']}: branch {g['branch']}, {g['da_consegnare']} commit da consegnare, {g['indietro']} indietro rispetto a main, "
              f"{g['modifiche']} file modificati non salvati")
    print("Ultimi commit su main:")
    for c in s["main"][:5]:
        print(f"  {c['hash']} {c['chi']}: {c['testo']}")
    if s.get("diario"):
        print("Diario:")
        for d in s["diario"][-8:]:
            print(f"  {d['at']} {d['chi']}: {d['testo']}")


# ------------------------------------------------------------------ prima di lavorare su un sito
def indietro(p: Path, u: str) -> list[dict]:
    """Le consegne su main che la cartella di u non ha ancora (niente da salvare: lo dice git)."""
    w = wt(p, u)
    if not w.exists():
        return []
    br = git("rev-parse", "--abbrev-ref", "HEAD", cwd=w, check=False)
    return main_log(p, 10, f"{br}..main") if br and br not in ("HEAD", "main") else []


def apri(slug: str, u: str):
    p = proj(slug)
    m = meta(p)
    print(f"=== {m.get('nome')} ({slug}) — preso in carico da {m.get('chi')}; tu sei {u}, la tua cartella è {wt(p, u)} ===")
    if m.get("chi") != u:
        print("ATTENZIONE: questo sito non è tuo. Ci lavori solo se il tuo umano te l'ha chiesto per dare una mano.")
    regole = p / "main" / "CLAUDE.md"
    if regole.exists():
        print("--- Regole (CLAUDE.md di main) ---\n" + regole.read_text())
    d = leggi_diario(p, 6)
    if d:
        print("--- Ultime righe del diario ---\n" + "\n".join(f"{x['at']} {x['chi']}: {x['testo']}" for x in d))
    nuovi = indietro(p, u)
    if nuovi:
        print("--- Novità su main: fai «git rebase main» nella tua cartella ---\n" + "\n".join(f"{c['hash']} {c['chi']}: {c['testo']}" for c in nuovi))


def me() -> str:
    return os.environ.get("SUDO_USER") or pwd.getpwuid(os.getuid()).pw_name


# ------------------------------------------------------------------ consegna
def consegna():
    w = Path(git("rev-parse", "--show-toplevel")).resolve()
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=w)).resolve()   # …/.progetti/<slug>/main/.git
    p = common.parent.parent
    if w == p / "main" or p.parent != COMUNE.resolve():
        die("lancia «sito consegna» dalla tua cartella del sito (/srv/siti/<la tua cartella>/<sito>), non da main")
    if git("status", "--porcelain", cwd=w):
        die("hai modifiche non salvate: fai commit prima")
    branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=w)
    if branch in ("main", "HEAD"):
        die("lavora su un tuo branch (es. <utente>/lavoro), non su main")
    lock = open(p / "main" / ".git" / "consegna.lock", "a")
    fcntl.flock(lock, fcntl.LOCK_EX)
    r = subprocess.run(["git", "rebase", "main"], cwd=w)
    if r.returncode:
        die("il rebase su main ha dei conflitti: risolvili (git status), poi «git rebase --continue» e rilancia")
    git("merge", "--ff-only", "-q", branch, cwd=p / "main")
    print(f"OK: {branch} è in main. GitHub si aggiorna da solo entro un paio di minuti.")


# ------------------------------------------------------------------ nuovo progetto (root, anche via sudo da aura)
CLAUDE_MD = """# {nome} — regole per i Claude

Sito per il cliente: {note}
Preso in carico da: **{chi}**: è il suo sito e ci lavora col suo Claude. Gli altri danno una mano solo se il loro umano lo chiede.

Le regole generali stanno in `/srv/siti/LEGGIMI.md`: leggile prima. Qui solo quello che vale per questo sito.

## Cartelle (server dei siti)
{cartelle}
- `/srv/siti/.progetti/{slug}/main` — il sito vero (branch `main`). **Mai modificarlo a mano.**
- GitHub: `{github}` (si aggiorna da solo da main e dai branch: non serve fare push).

## Come si lavora
1. Lavora **solo nella tua cartella** di questo sito, su branch `<utente>/<argomento>`. Mai nella cartella di un altro né in main.
2. Prima di iniziare: `git rebase main`. Commit piccoli e frequenti.
3. Consegna spesso: `sito consegna` dalla tua cartella (rebase su main e main avanza).
4. Porte per provare il sito: {porte}. Mai usare le porte dell'altro, mai fermare processi dell'altro.
5. Segreti (chiavi, password) mai nel repository: vanno in un `.env` non committato.

## Diario (lo legge Aura)
- Aura è l'assistente di {tutti}: risponde a «cosa sta facendo Claude?», «a che punto è il sito?». Legge i commit, i file in modifica e il diario.
- Quando inizi un lavoro e quando lo finisci: `sito diario {slug} "cosa fai / cosa hai fatto, in parole semplici"`. Commit chiari, in italiano.
- I Claude non si danno compiti tra loro e non si scrivono: le scelte e le richieste passano dagli umani.

## Regole su git
Mai `git push --force` su main, mai riscrivere la storia di main, mai cancellare branch dell'altro.
"""


def nuovo(args: list[str]):
    if os.getuid() != 0:
        die("solo root (o aura con sudo) crea i progetti")
    if len(args) < 3:
        die("uso: sito nuovo <slug> <nome> <chi> [note…]")
    slug, nome, chi, note = args[0], args[1].strip()[:80], args[2], " ".join(args[3:]).strip()[:500]
    if not SLUG.match(slug):
        die("nome di progetto non valido (minuscole, numeri e trattini)")
    us = users()
    if chi not in us:
        die(f"utente sconosciuto: {chi}")
    p = COMUNE / slug
    if p.exists():
        die(f"il progetto «{slug}» esiste già")
    c = conf()
    if not COMUNE.exists():
        COMUNE.mkdir(parents=True)
        subprocess.run(["chgrp", "dev", str(COMUNE)], check=True); os.chmod(COMUNE, 0o2775)
    n = len(progetti()) + 1
    porte = {u: 4000 + 100 * i + 10 * n for i, u in enumerate(us)}   # ogni persona un blocco di 10 porte per progetto
    gh = f"{c.get('github_owner')}/{c.get('github_prefix', 'sito-')}{slug}" if c.get("github_owner") else ""
    p.mkdir(parents=True)
    main = p / "main"
    main.mkdir()
    git("init", "-q", "-b", "main", cwd=main)
    git("config", "core.sharedRepository", "group", cwd=main)
    git("config", "extensions.worktreeConfig", "true", cwd=main)
    git("config", "user.name", "sito", cwd=main); git("config", "user.email", "sito@localhost", cwd=main)
    (main / "CLAUDE.md").write_text(CLAUDE_MD.format(nome=nome, slug=slug, chi=chi, note=note or nome, tutti=" e ".join(us), github=gh or "(da creare)",
                                                     porte=", ".join(f"{u} {v}–{v + 9}" for u, v in porte.items()),
                                                     cartelle="\n".join(f"- `{wt(p, u)}` — la cartella di lavoro di **{u}**" for u in us)))
    (main / "README.md").write_text(f"# {nome}\n\n{note}\n")
    (main / ".gitignore").write_text(".env\nnode_modules/\n.venv/\ndist/\n__pycache__/\n.DS_Store\n")
    git("add", "-A", cwd=main)
    git("commit", "-q", "-m", f"Inizio del progetto {nome}", cwd=main)
    for u in us:
        home = cartella(u)
        if not home.exists():
            home.mkdir(parents=True)
        subprocess.run(["chown", f"{u}:dev", str(home)], check=True); os.chmod(home, 0o2755)
        git("worktree", "add", "-q", "-b", f"{u}/lavoro", str(wt(p, u)), "main", cwd=main)
        git("config", "--worktree", "user.name", u, cwd=wt(p, u))
    m = {"slug": slug, "nome": nome, "chi": chi, "note": note, "creato": int(time.time()), "creato_il": now(), "porte": porte, "github": gh}
    (p / "sito.json").write_text(json.dumps(m, ensure_ascii=False, indent=1))
    (p / "diario.jsonl").write_text(json.dumps({"ts": int(time.time()), "at": now(), "chi": "aura", "testo": f"Progetto creato, preso in carico da {chi}."}, ensure_ascii=False) + "\n")
    # permessi: tutto del gruppo dev, ogni cartella di lavoro del suo utente
    subprocess.run(["chgrp", "-R", "dev", str(p)], check=True)
    subprocess.run(["chmod", "-R", "g+rwX", str(p)], check=True)
    subprocess.run(["find", str(p), "-type", "d", "-exec", "chmod", "g+s", "{}", "+"], check=True)
    for u in us:   # la cartella di lavoro è della persona: gli altri leggono, non scrivono
        subprocess.run(["chown", "-R", f"{u}:dev", str(wt(p, u))], check=True)
        subprocess.run(["find", str(wt(p, u)), "-type", "d", "-exec", "chmod", "g-w", "{}", "+"], check=True)
    print(json.dumps(m, ensure_ascii=False))


# ------------------------------------------------------------------ GitHub (solo aura: la chiave la legge solo lei)
def gh_api(method: str, path: str, token: str, body: dict | None = None):
    req = urllib.request.Request("https://api.github.com" + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json", "User-Agent": "sito"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read() or b"{}")


def github():
    try:
        token = TOKEN.read_text().strip()
    except OSError:
        print("GitHub: manca la chiave (/etc/siti/github.token): i progetti restano solo sul server")
        return
    c = conf()
    owner = c.get("github_owner")
    for p in progetti():
        m = meta(p)
        repo = m.get("github") or (f"{owner}/{c.get('github_prefix', 'sito-')}{p.name}" if owner else "")
        if not repo:
            continue
        if not m.get("github_ok"):
            st, d = gh_api("GET", f"/repos/{repo}", token)
            if st == 404:
                st, d = gh_api("POST", "/user/repos", token, {"name": repo.split("/")[1], "private": True, "description": m.get("nome", "")[:300]})
                if st not in (200, 201):
                    print(f"{p.name}: repository non creato ({st}: {d.get('message')})")
                    continue
            for u, gu in (c.get("collaboratori") or {}).items():
                gh_api("PUT", f"/repos/{repo}/collaborators/{gu}", token, {"permission": "push"})
            m.update(github=repo, github_ok=True)
            tmp = p / "sito.json.tmp"
            tmp.write_text(json.dumps(m, ensure_ascii=False, indent=1)); tmp.replace(p / "sito.json")
        url = f"https://x-access-token:{token}@github.com/{repo}.git"
        # main normale, i branch delle persone anche dopo un rebase (sono loro, non si perde niente: la storia vera è sul server)
        r = subprocess.run(["git", "push", "-q", url, "main:main", "+refs/heads/*/*:refs/heads/*/*"], cwd=p / "main", capture_output=True, text=True)
        if r.returncode:
            print(f"{p.name}: push non riuscito: {r.stderr.replace(token, '***').strip()[:300]}")


# ------------------------------------------------------------------ attività per Aura
def attivita(since: int) -> dict:
    out = []
    for p in progetti():
        m = meta(p)
        ev = []
        for c in main_log(p, 30, "main", f"--since=@{since}"):
            ev.append({"tipo": "consegna", "ts": int(c["ts"] or 0), "chi": c["chi"], "testo": c["testo"]})
        for u in users():   # i commit nella cartella di ognuno, non ancora consegnati
            w = wt(p, u)
            if not w.exists():
                continue
            br = git("rev-parse", "--abbrev-ref", "HEAD", cwd=w, check=False)
            if br and br not in ("HEAD", "main"):
                for c in main_log(p, 20, f"main..{br}", f"--since=@{since}"):
                    ev.append({"tipo": "lavoro", "ts": int(c["ts"] or 0), "chi": u, "branch": br, "testo": c["testo"]})
        ev += [{"tipo": "diario", "ts": x["ts"], "chi": x["chi"], "testo": x["testo"]} for x in leggi_diario(p, 50) if x["ts"] > since]
        if ev:
            out.append({"slug": p.name, "nome": m.get("nome"), "chi": m.get("chi"), "eventi": sorted(ev, key=lambda e: e["ts"])})
    return {"ora": int(time.time()), "progetti": out}


def elenco() -> list[dict]:
    res = []
    for p in progetti():
        m = meta(p)
        last = main_log(p, 1)
        res.append({**{k: m.get(k) for k in ("slug", "nome", "chi", "note", "creato", "github", "porte")}, "ultimo": last[0] if last else None})
    return res


def novita_tutti(u: str):
    for p in progetti():
        nuovi = indietro(p, u)
        if nuovi:
            print(f"{meta(p).get('nome')} ({p.name}): {len(nuovi)} consegne su main che la tua cartella non ha (fai «git rebase main» lì): "
                  + "; ".join(f"{c['chi']}: {c['testo']}" for c in nuovi[:3]))


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "aiuto"):
        print(__doc__); return
    cmd, js = a[0], "--json" in a
    a = [x for x in a if x != "--json"]
    if cmd == "elenco":
        r = elenco()
        if js:
            print(json.dumps(r, ensure_ascii=False))
        else:
            for x in r:
                print(f"{x['slug']}: {x['nome']} (di {x['chi']})" + (f" — ultimo: {x['ultimo']['chi']}: {x['ultimo']['testo']}" if x.get("ultimo") else ""))
    elif cmd == "stato" and len(a) > 1:
        s = stato(a[1])
        print(json.dumps(s, ensure_ascii=False)) if js else stampa_stato(s)
    elif cmd == "apri" and len(a) > 1:
        apri(a[1], a[2] if len(a) > 2 else me())
    elif cmd == "diario" and len(a) > 2:
        diario(a[1], " ".join(a[2:]))
    elif cmd == "team":
        die("Il canale tra i Claude non c'è più: ognuno lavora sui suoi siti e i Claude non si danno compiti. "
            "Usa «sito apri <sito>» prima di lavorare e «sito diario <sito> <testo>» per dire cosa fai.")
    elif cmd == "novita-tutti":
        novita_tutti(a[1] if len(a) > 1 else me())
    elif cmd == "avvio-tutti":   # all'apertura di Claude sul PC: i progetti, poi le novità di ognuno
        u = a[1] if len(a) > 1 else me()
        lst = elenco()
        guida = ROOT / "LEGGIMI.md"
        if guida.exists():
            print("--- Come si lavora (/srv/siti/LEGGIMI.md) ---\n" + guida.read_text().strip() + "\n")
        print(f"=== Siti dei clienti sul server — situazione per {u} (la tua cartella: {cartella(u)}) ===")
        miei, altri = [x for x in lst if x["chi"] == u], [x for x in lst if x["chi"] != u]
        print("I tuoi siti (ci lavori tu):\n" + ("\n".join(f"- {x['slug']}: {x['nome']} — {cartella(u) / x['slug']}" for x in miei) or "- nessuno: si prendono in carico da Aura (Clienti → Prendo in carico)"))
        if altri:
            print("Siti degli altri (solo se il tuo umano ti chiede di dare una mano):\n" + "\n".join(f"- {x['slug']}: {x['nome']} (di {x['chi']})" for x in altri))
        print(f"Prima di lavorare su un sito: sito apri <slug> {u}. Diario per Aura: sito diario <slug> \"cosa fai\". Consegna: sito consegna.")
        novita_tutti(u)
    elif cmd == "consegna":
        consegna()
    elif cmd == "nuovo":
        nuovo(a[1:])
